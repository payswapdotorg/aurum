{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  // CR-W001 precedent (rpc -> shared, client -> rpc): without an explicit
  // project reference, typecheck follows the workspace package entrypoint and
  // drags @zcode/shared source into this compile context (rootDir violation /
  // node-type errors). With the reference, tsc -b builds shared first and this
  // package consumes the boundary's declaration output instead.
  "references": [{ "path": "../shared" }]
}
